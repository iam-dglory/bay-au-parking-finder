{
  "name": "bay-parking",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:native": "tsc -b && VITE_ASSET_BASE_URL=${VITE_ASSET_BASE_URL:-https://iam-dglory.github.io/bay-au-parking-finder} vite build && node scripts/strip-native-data.mjs",
    "cap:android": "npm run build:native && npx cap sync android",
    "cap:ios": "npm run build:native && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.112.1",
    "@vis.gl/react-google-maps": "^1.9.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.25",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
