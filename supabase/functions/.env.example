# Copy to a local, ignored Edge Functions environment file or configure with
# Supabase secrets. Never prefix any server secret with VITE_.
MARKETPLACE_PAYMENTS_ENABLED=false
MARKETPLACE_ALLOW_LIVE_STRIPE=false
STRIPE_CONNECT_ARCHITECTURE=express_destination_charges

# Server-only secrets (use test-mode values until the launch gates are signed off).
STRIPE_SECRET_KEY=sk_test_REPLACE_IN_SECRET_MANAGER
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_IN_SECRET_MANAGER
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SECRET_MANAGER

# Comma-separated exact browser/app origins. No wildcard is used.
MARKETPLACE_ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost
MARKETPLACE_CONNECT_RETURN_URL=http://localhost:5173/?marketplace-connect=return
MARKETPLACE_CONNECT_REFRESH_URL=http://localhost:5173/?marketplace-connect=refresh
MARKETPLACE_CHECKOUT_SUCCESS_URL=http://localhost:5173/?marketplace-checkout=success&session_id={CHECKOUT_SESSION_ID}
MARKETPLACE_CHECKOUT_CANCEL_URL=http://localhost:5173/?marketplace-checkout=cancel

