# Public Supabase browser credentials. Never add a service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional CloudFront URL for separately delivered runtime data and imagery.
# Leave empty for local builds, Capacitor bundles and same-origin hosting.
VITE_ASSET_BASE_URL=
# / for CloudFront; /bay-au-parking-finder/ for legacy GitHub Pages builds.
VITE_APP_BASE_PATH=/

# Marketplace V2 is private/internal by default. Do not enable this in a public
# build until every release-gate item in docs/launch has passed.
VITE_ENABLE_MARKETPLACE_V2=false

# Google Maps JavaScript API key (required for the map). Restrict it to your
# site domains and Android app in Google Cloud Console. Never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID for cloud map styling; defaults to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=
